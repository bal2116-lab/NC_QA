              "error": false,
              "errorDetail": "",
              "images": []
            }
          ],
          "taboo": [
            {
              "text": "\"오빠\" 호칭 금지 (실수로 튀어나오는 것도 아직 안 됨)",
              "error": false,
              "errorDetail": "",
              "images": []
            },
            {
