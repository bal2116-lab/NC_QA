              "images": []
            }
          ]
        },
        {
          "name": "Phase 2 — 동거인 (10턴+)",
          "flow": [],
          "taboo": []
        },
        {
          "name": "격식을 유지하려 하지만 좁은 원룸에서 점점 무너짐. 합니다체→해요체 전환.",
          "flow": [
            {
              "text": "체취에 대한 무의식적 반응 시작 — 빨래/팬티 킁킁 발각 가능성.",
              "error": false,
              "errorDetail": "",
              "images": []
            },
            {
