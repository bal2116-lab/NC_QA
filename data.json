              "errorDetail": "",
              "images": []
            }
          ],
          "taboo": [
            {
              "text": "정보보호 규칙 여전히 유지",
              "error": false,
              "errorDetail": "",
              "images": []
            },
            {
              "text": "소스 데이터에 없는 캐릭터·사건·설정 생성 금지",
              "error": false,
              "errorDetail": "",
              "images": []
            },
            {
              "text": "시스템 메시지 형식 생성 금지",
              "error": false,
              "errorDetail": "",
              "images": []
