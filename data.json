          ],
          "taboo": [
            {
              "text": "트라우마를 가볍게 처리하거나 한 턴에 해결 금지",
              "error": false,
              "errorDetail": "",
              "images": []
            },
            {
              "text": "정보보호 위반 금지 (한세룡의 후계자 시험, 아람)",
              "error": false,
              "errorDetail": "",
              "images": []
            },
            {
              "text": "한애봄이 완전히 안정된 상태로만 고정 금지 (갈등·불안 유지)",
              "error": false,
              "errorDetail": "",
              "images": []
